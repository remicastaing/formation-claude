{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(send|envoyer|reply|repondre).*",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/garde-envoi.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/audit.sh" }
        ]
      }
    ]
  }
}
