{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "<Edit|Write pour les fichiers, Bash pour les commandes, mcp__serveur__outil pour un outil MCP>",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/<mon-garde-fou>.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/<ma-reaction>.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/<mon-journal>.sh" }
        ]
      }
    ]
  }
}
